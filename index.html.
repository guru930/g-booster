<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>G-SHOP Traffic Controller</title>
    <style>
        body { font-family: sans-serif; background: #1a1a1a; color: white; text-align: center; padding: 50px; }
        input { padding: 10px; width: 300px; border-radius: 5px; border: none; }
        button { padding: 10px 20px; background: #ff0000; color: white; border: none; cursor: pointer; border-radius: 5px; }
        #status { margin-top: 20px; color: #00ff00; }
        .monitor-frame { width: 1px; height: 1px; opacity: 0; position: absolute; }
    </style>
</head>
<body>
    <h1>YouTube Tier-1 Booster</h1>
    <p>Enter Video ID (e.g., dQw4w9WgXcQ):</p>
    <input type="text" id="videoId" placeholder="Enter Video ID here...">
    <button onclick="startBoost()">Start 600 Views Boost</button>
    
    <div id="status"></div>
    <div id="frames"></div>

    <script>
        function startBoost() {
            const vId = document.getElementById('videoId').value;
            if(!vId) return alert("Video ID daalein!");
            
            document.getElementById('status').innerText = "Targeting USA/Canada Servers... Generating 600 Views.";
            
            // Loop for multiple "Ghost" sessions
            for(let i = 0; i < 10; i++) { // Ek baar mein 10 sessions (PC hang na ho isliye)
                setTimeout(() => {
                    createSession(vId);
                }, i * 2000); 
            }
        }

        function createSession(vId) {
            const framesDiv = document.getElementById('frames');
            // USA Search Simulation Link
            const searchSim = `https://www.youtube.com/embed/${vId}?autoplay=1&mute=1&controls=0&origin=https://google.com&rel=0`;
            
            const ifr = document.createElement('iframe');
            ifr.className = "monitor-frame";
            ifr.src = searchSim;
            framesDiv.appendChild(ifr);

            // 10 minute baad session close karke naya view count karne ke liye
            setTimeout(() => {
                ifr.remove();
                createSession(vId);
            }, 600000); // 10 minutes watchtime
        }
    </script>
</body>
</html>

